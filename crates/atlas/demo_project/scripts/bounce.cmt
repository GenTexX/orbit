// A bouncing node, and a tour of what Comet can do today.
//
// A top-level `let` is script state: it keeps its value between frames.
// `start()` runs once, before the first frame. `transform.position` is this node's position -
// read it, or assign to it, to move the node.

let home = transform.position;
let velocity = vec2(0.0, 0.0);

// `start()` runs once, before the first frame - and deliberately not again when
// you save this file. A script that placed its node in `start` would otherwise
// jump back to the beginning every time you pressed ctrl+S.
//
// Save this file while the game runs and watch: the node keeps going from
// wherever it was, because plain state like `velocity` is carried across a
// reload. Anything held on the heap - a String, an Array - starts fresh.
func start() {
    velocity = vec2(120.0, 0.0);
    print("off we go from " + str(home));
}

// Functions declare their types. The last expression in a body, written with
// no semicolon, is what the function gives back.
func past_edge(x: f32, edge: f32) -> bool {
    x > edge || x < -edge
}

// A bare `200` is an int; `200.0` is an f32. An int widens to an f32 wherever
// one is wanted, so this reads the way you would say it out loud.
func update(dt: f32) {
    // Vectors add, subtract, and scale by a number, so a whole frame of
    // movement is one line rather than one line per axis.
    transform.position += velocity * dt;

    if past_edge(transform.position.x, 200) {
        velocity = -velocity;
        print("turned around");
    }

    // Vec2 is a value, not a reference: `home` still holds where the node
    // started, however far the line above has moved it since.
    transform.position.y = home.y;
}
