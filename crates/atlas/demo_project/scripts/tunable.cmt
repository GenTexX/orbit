// An exported variable is edited in the inspector, not in the script.
//
// `@export` marks a variable as one the inspector owns. Two nodes running this
// same file can move at different speeds, because the value lives on each
// node's Script component rather than in the source.
//
// Note there is no number here: an exported variable carries only its type.
// Writing one would be a second answer to the same question, and the compiler
// says so if you do.

// An annotation says how the inspector should show a value. `@range` makes it
// a slider, `@step` sets how far one drag moves it, `@tooltip` explains it, and
// `@readonly` shows a value without letting you change it.

@export
@range(0.0, 500.0)
@tooltip("pixels per second")
let speed: f32;

@export let direction: Vec2;

@export @readonly @tooltip("set by the script, shown for reference") let travelled: f32;

func start() {
    print("starting at speed " + str(speed));
}

func update(dt: f32) {
    transform.position += direction * speed * dt;
    travelled = travelled + speed * dt;
}
